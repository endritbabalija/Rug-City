# ── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_WEBHOOK_SECRET=       # random string, A-Z a-z 0-9 _ -
NEXT_PUBLIC_BOT_USERNAME=      # without @, e.g. WhoRuggedBot
NEXT_PUBLIC_APP_SHORT_NAME=    # Mini App short name from /newapp, e.g. play
APP_URL=                       # public https URL of this deployment
ADMIN_TELEGRAM_IDS=            # comma-separated ids allowed to /refund

# ── Supabase (leave empty to use the in-memory dev store) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= # publishable key (sb_publishable_…), only used for Realtime pings
SUPABASE_SERVICE_ROLE_KEY=     # secret key (sb_secret_…), server only

# ── AI suspect chats (leave empty for scripted replies) ─────
ANTHROPIC_API_KEY=
SUSPECT_MODEL=claude-haiku-5-5

# ── Local development only (ignored when NODE_ENV=production)
DEV_AUTH=1                     # play in a normal browser as fake users
DEV_MIN_PLAYERS=               # e.g. 1 to test a case alone
