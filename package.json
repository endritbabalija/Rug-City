{
  "name": "rug-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot:setup": "node --env-file-if-exists=.env.local scripts/setup-bot.mjs",
